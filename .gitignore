# .local — công cụ cục bộ (đường dẫn PHP, log máy chủ)
.local/

# Biến môi trường / bí mật
.env
.env.*
*.env

# Thông tin kết nối CSDL cục bộ (chứa mật khẩu tài khoản MySQL riêng của ứng dụng).
# Được sinh tự động bởi scripts/setup_db.php — TUYỆT ĐỐI KHÔNG commit.
config/db.local.php

# Kịch bản cài đặt cục bộ — chứa mật khẩu quản trị MySQL do người dùng nhập.
# TUYỆT ĐỐI KHÔNG commit (chứa bí mật).
setup.ps1

# Trợ giúp đăng nhập MySQL cục bộ (hỏi mật khẩu ẩn, không lưu mật khẩu).
connect-db.ps1

# Trợ giúp chuẩn bị database 3306 (sao lưu + tạo tài khoản ứng dụng + migration).
# Chạy cục bộ, KHÔNG commit.
setup-3306.ps1

# Trợ giúp TIẾP TỤC từ bước sinh file cấu hình 3306 (chạy cục bộ, KHÔNG commit).
prepare-3306-config.ps1

# Cấu hình "chờ chuyển" 3306 + bản sao cấu hình 3307 (CHỨA MẬT KHẨU).
# Sinh bởi setup-3306.ps1 trong .local\backup — đã nằm trong `.local/`,
# nhưng khai báo thêm để chắc chắn kể cả khi đổi vị trí lưu.
db.local.*.php
db.local.3306.pending.php
db.local.3307.php

# Log
*.log
logs/
*.log.*

# Tệp nhị phân do capture tải về (ảnh trong bài viết). Giữ cấu trúc thư mục bằng
# .gitkeep, KHÔNG commit ảnh đã tải.
public/uploads/*
!public/uploads/.gitkeep
!public/uploads/snapshots/
public/uploads/snapshots/*
!public/uploads/snapshots/.gitkeep

# Hệ điều hành / trình soạn thảo
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# Tài liệu làm việc nội bộ của agent/developer (prompt & context) — KHÔNG commit,
# chỉ dùng cục bộ.
/prompt.md
/PROJECT_CONTEXT.md
